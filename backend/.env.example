# Runtime
NODE_ENV=development
PORT=4000
APP_VERSION=0.1.0
LOG_LEVEL=info

# Browser origin allowed to call the API with credentials.
# Must be the exact frontend origin, for example http://localhost:5173.
FRONTEND_URL=http://localhost:5173

# Session settings (used from phase 13 onward).
SESSION_TTL_HOURS=168
COOKIE_SECURE=false

# Database (required from phase 12 onward).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/food_donation

# Background jobs (no jobs are started in phase 11).
JOBS_ENABLED=true

# Storage (local in development, S3-compatible in production).
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=var/uploads
MAX_UPLOAD_BYTES=10485760

# S3 settings are only needed when STORAGE_DRIVER=s3.
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
