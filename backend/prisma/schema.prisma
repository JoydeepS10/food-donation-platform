// Food Donation Coordination System — full MVP schema.
//
// The PostgreSQL enums, tables, foreign keys and ordinary indexes are generated by Prisma.
// Partial unique indexes and CHECK constraints cannot be expressed in the Prisma schema;
// they live in the hand-written `*_constraints` migration and must stay in the migration
// history. See `docs/01-planning/DATABASE_DESIGN.md` and `docs/04-backend/BACKEND_PLAN.md`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  donor
  ngo
  admin

  @@map("user_role")
}

enum OrgType {
  donor
  ngo

  @@map("org_type")
}

enum OrgVerificationStatus {
  pending
  verified
  rejected

  @@map("org_verification_status")
}

enum DocumentType {
  business_registration
  food_safety_licence
  ngo_registration
  institution_authorisation
  other

  @@map("document_type")
}

enum DocumentStatus {
  pending
  approved
  rejected

  @@map("document_status")
}

enum QuantityUnit {
  kg
  portions
  meals
  packets

  @@map("quantity_unit")
}

enum DonationStatus {
  available
  claimed
  picked_up
  completed
  expired
  cancelled

  @@map("donation_status")
}

enum ClaimStatus {
  active
  cancelled
  completed

  @@map("claim_status")
}

enum NotificationType {
  organisation_verified
  organisation_rejected
  donation_claimed
  claim_released
  donation_cancelled
  pickup_confirmed
  donation_completed
  donation_expired

  @@map("notification_type")
}

enum AuthTokenType {
  email_verification
  password_reset

  @@map("auth_token_type")
}

model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId  String?   @unique @map("organisation_id") @db.Uuid
  role            UserRole
  email           String    @unique @db.VarChar(254)
  passwordHash    String    @map("password_hash")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  isActive        Boolean   @default(true) @map("is_active")
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation          Organisation?           @relation("OrganisationMembers", fields: [organisationId], references: [id], onDelete: Restrict)
  verifiedOrganisations Organisation[]          @relation("OrganisationVerifiedBy")
  uploadedDocuments     VerificationDocument[]  @relation("DocumentUploader")
  reviewedDocuments     VerificationDocument[]  @relation("DocumentReviewer")
  createdClaims         Claim[]                 @relation("ClaimCreator")
  cancelledClaims       Claim[]                 @relation("ClaimCanceller")
  cancelledDonations    Donation[]              @relation("DonationCanceller")
  statusHistoryChanges  DonationStatusHistory[] @relation("StatusHistoryActor")
  notifications         Notification[]
  sessions              Session[]
  authTokens            AuthToken[]

  @@map("users")
}

model Organisation {
  id                      String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type                    OrgType
  name                    String                @db.VarChar(160)
  registrationNumber      String?               @map("registration_number") @db.VarChar(80)
  contactName             String                @map("contact_name") @db.VarChar(120)
  contactPhone            String                @map("contact_phone") @db.VarChar(32)
  contactEmail            String                @map("contact_email") @db.VarChar(254)
  addressLine1            String                @map("address_line1") @db.VarChar(200)
  addressLine2            String?               @map("address_line2") @db.VarChar(200)
  area                    String                @db.VarChar(120)
  city                    String                @db.VarChar(120)
  postcode                String?               @db.VarChar(16)
  verificationStatus      OrgVerificationStatus @default(pending) @map("verification_status")
  verificationSubmittedAt DateTime?             @map("verification_submitted_at") @db.Timestamptz(6)
  verifiedAt              DateTime?             @map("verified_at") @db.Timestamptz(6)
  verifiedByUserId        String?               @map("verified_by_user_id") @db.Uuid
  rejectionReason         String?               @map("rejection_reason")
  createdAt               DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  users      User[]                 @relation("OrganisationMembers")
  verifiedBy User?                  @relation("OrganisationVerifiedBy", fields: [verifiedByUserId], references: [id], onDelete: Restrict)
  documents  VerificationDocument[]
  donations  Donation[]             @relation("OrganisationDonations")
  claims     Claim[]                @relation("OrganisationClaims")

  @@unique([type, registrationNumber])
  @@index([verificationStatus, verificationSubmittedAt])
  @@index([type, city])
  @@map("organisations")
}

model VerificationDocument {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId   String         @map("organisation_id") @db.Uuid
  uploadedByUserId String         @map("uploaded_by_user_id") @db.Uuid
  documentType     DocumentType   @map("document_type")
  status           DocumentStatus @default(pending)
  isCurrent        Boolean        @default(true) @map("is_current")
  storageKey       String         @unique @map("storage_key")
  originalFilename String         @map("original_filename") @db.VarChar(255)
  mimeType         String         @map("mime_type") @db.VarChar(100)
  sizeBytes        Int            @map("size_bytes")
  reviewNote       String?        @map("review_note")
  reviewedByUserId String?        @map("reviewed_by_user_id") @db.Uuid
  reviewedAt       DateTime?      @map("reviewed_at") @db.Timestamptz(6)
  uploadedAt       DateTime       @default(now()) @map("uploaded_at") @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  uploadedBy   User         @relation("DocumentUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  reviewedBy   User?        @relation("DocumentReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)

  @@index([organisationId, uploadedAt(sort: Desc)])
  @@index([status, uploadedAt])
  @@map("verification_documents")
}

model Donation {
  id                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  donorOrganisationId String         @map("donor_organisation_id") @db.Uuid
  title               String         @db.VarChar(140)
  description         String
  isVegetarian        Boolean        @map("is_vegetarian")
  quantity            Decimal        @db.Decimal(10, 2)
  unit                QuantityUnit
  bestBefore          DateTime       @map("best_before") @db.Timestamptz(6)
  pickupWindowStart   DateTime       @map("pickup_window_start") @db.Timestamptz(6)
  pickupWindowEnd     DateTime       @map("pickup_window_end") @db.Timestamptz(6)
  pickupAddressLine1  String         @map("pickup_address_line1") @db.VarChar(200)
  pickupAddressLine2  String?        @map("pickup_address_line2") @db.VarChar(200)
  pickupArea          String         @map("pickup_area") @db.VarChar(120)
  pickupCity          String         @map("pickup_city") @db.VarChar(120)
  pickupPostcode      String?        @map("pickup_postcode") @db.VarChar(16)
  pickupInstructions  String?        @map("pickup_instructions")
  allergenNotes       String?        @map("allergen_notes")
  photoStorageKey     String?        @map("photo_storage_key")
  status              DonationStatus @default(available)
  cancelledByUserId   String?        @map("cancelled_by_user_id") @db.Uuid
  cancelReason        String?        @map("cancel_reason")
  cancelledAt         DateTime?      @map("cancelled_at") @db.Timestamptz(6)
  completedAt         DateTime?      @map("completed_at") @db.Timestamptz(6)
  version             Int            @default(0)
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  donorOrganisation Organisation            @relation("OrganisationDonations", fields: [donorOrganisationId], references: [id], onDelete: Restrict)
  cancelledBy       User?                   @relation("DonationCanceller", fields: [cancelledByUserId], references: [id], onDelete: Restrict)
  claims            Claim[]
  statusHistory     DonationStatusHistory[]
  notifications     Notification[]

  @@index([status, createdAt(sort: Desc)])
  @@index([donorOrganisationId, createdAt(sort: Desc)])
  @@map("donations")
}

model Claim {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  donationId        String      @map("donation_id") @db.Uuid
  ngoOrganisationId String      @map("ngo_organisation_id") @db.Uuid
  claimedByUserId   String      @map("claimed_by_user_id") @db.Uuid
  status            ClaimStatus @default(active)
  claimedAt         DateTime    @default(now()) @map("claimed_at") @db.Timestamptz(6)
  pickupConfirmedAt DateTime?   @map("pickup_confirmed_at") @db.Timestamptz(6)
  completedAt       DateTime?   @map("completed_at") @db.Timestamptz(6)
  cancelledAt       DateTime?   @map("cancelled_at") @db.Timestamptz(6)
  cancelledByUserId String?     @map("cancelled_by_user_id") @db.Uuid
  cancelReason      String?     @map("cancel_reason")
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  donation      Donation       @relation(fields: [donationId], references: [id], onDelete: Restrict)
  ngo           Organisation   @relation("OrganisationClaims", fields: [ngoOrganisationId], references: [id], onDelete: Restrict)
  claimedBy     User           @relation("ClaimCreator", fields: [claimedByUserId], references: [id], onDelete: Restrict)
  cancelledBy   User?          @relation("ClaimCanceller", fields: [cancelledByUserId], references: [id], onDelete: Restrict)
  notifications Notification[]

  @@index([ngoOrganisationId, claimedAt(sort: Desc)])
  @@index([donationId, claimedAt(sort: Desc)])
  @@map("claims")
}

model DonationStatusHistory {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  donationId      String          @map("donation_id") @db.Uuid
  fromStatus      DonationStatus? @map("from_status")
  toStatus        DonationStatus  @map("to_status")
  changedByUserId String?         @map("changed_by_user_id") @db.Uuid
  reason          String?
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  donation  Donation @relation(fields: [donationId], references: [id], onDelete: Restrict)
  changedBy User?    @relation("StatusHistoryActor", fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([donationId, createdAt])
  @@map("donation_status_history")
}

model Notification {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  type       NotificationType
  title      String           @db.VarChar(140)
  body       String
  donationId String?          @map("donation_id") @db.Uuid
  claimId    String?          @map("claim_id") @db.Uuid
  readAt     DateTime?        @map("read_at") @db.Timestamptz(6)
  emailedAt  DateTime?        @map("emailed_at") @db.Timestamptz(6)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  user     User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  donation Donation? @relation(fields: [donationId], references: [id], onDelete: SetNull)
  claim    Claim?    @relation(fields: [claimId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

model Session {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  userAgent  String?   @map("user_agent") @db.VarChar(255)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model AuthToken {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  type      AuthTokenType
  tokenHash String        @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime      @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime?     @map("used_at") @db.Timestamptz(6)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, expiresAt])
  @@map("auth_tokens")
}
