{
  "name": "food-donation-backend",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript API for the food donation coordination platform",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "npm run typecheck",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "test": "npm run typecheck && node --env-file-if-exists=.env --test \"tests/**/*.test.ts\"",
    "test:unit": "node --env-file-if-exists=.env --test \"tests/unit/**/*.test.ts\"",
    "test:integration": "node --env-file-if-exists=.env --test \"tests/integration/**/*.test.ts\"",
    "test:database": "node --env-file-if-exists=.env --test \"tests/integration/database.test.ts\""
  },
  "prisma": {
    "seed": "node --env-file-if-exists=.env prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.6",
    "prisma": "^6.19.3",
    "typescript": "^5.9.3"
  }
}
